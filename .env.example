# --- Database (pgAdmin / PostgreSQL) ---
DATABASE_URL=postgresql://postgres:1111@localhost:5432/soulsanctuary

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Frontend (React) ---
# The React app reads its own settings from frontend/.env (VITE_API_BASE_URL etc.).
# CORS_ORIGINS below must contain the address the React app runs on.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Seed ---
ADMIN_EMAIL=admin@soulsanctuary.local
ADMIN_PASSWORD=ChangeMe123
SEED_DEMO_DATA=false

# --- Social media ---
PUBLIC_APP_URL=http://localhost:5173
INSTAGRAM_URL=https://www.instagram.com/your-page
FACEBOOK_URL=https://www.facebook.com/your-page
YOUTUBE_URL=https://www.youtube.com/@your-channel
# Optional Meta Graph API sync (leave empty to use stored values)
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_SYNC_MINUTES=60
